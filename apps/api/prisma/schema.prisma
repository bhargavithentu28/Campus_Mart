generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum UserRole {
  STUDENT
  FACULTY
  CLUB
  ALUMNI
  MODERATOR
  COLLEGE_ADMIN
  SUPER_ADMIN
}

enum TransactionType {
  BUY
  SELL
  RENT
  BORROW
  EXCHANGE
  DONATE
}

enum ProductStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  RESERVED
  SOLD
  RENTED
  BORROWED
  EXCHANGED
  DONATED
  EXPIRED
  REJECTED
  ARCHIVED
}

enum ProductCondition {
  NEW
  LIKE_NEW
  GOOD
  FAIR
  POOR
}

enum OrderStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum RentalStatus {
  REQUESTED
  ACTIVE
  RETURNED
  OVERDUE
  CANCELLED
}

enum ExchangeStatus {
  PENDING
  ACCEPTED
  COMPLETED
  DECLINED
}

enum ReportStatus {
  PENDING
  REVIEWED
  RESOLVED
  DISMISSED
}

enum NotificationType {
  MESSAGE
  OFFER
  WISHLIST
  PRICE_DROP
  SYSTEM
  RENTAL_DUE
}

// ============================================================
// MODELS
// ============================================================

model College {
  id          String   @id @default(cuid())
  name        String
  code        String   @unique
  domains     String[] // e.g. ["coep.ac.in", "student.coep.ac.in"]
  city        String
  state       String
  country     String   @default("India")
  logo        String?
  isVerified  Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  users       User[]
  products    Product[]
  departments Department[]

  @@index([code])
}

model Department {
  id        String   @id @default(cuid())
  collegeId String
  college   College  @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  name      String
  code      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users     User[]
  products  Product[]

  @@unique([collegeId, code])
}

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  name           String
  avatar         String?
  role           UserRole  @default(STUDENT)
  collegeId      String
  college        College   @relation(fields: [collegeId], references: [id])
  departmentId   String?
  department     Department? @relation(fields: [departmentId], references: [id])
  year           Int?      @default(1)
  branch         String?
  bio            String?
  badges         String[]  @default(["Verified Student"])
  isVerified     Boolean   @default(false)
  isAdmin        Boolean   @default(false)
  
  // Security & Sessions
  passwordHash   String?
  googleId       String?   @unique
  trustedDevices String[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  // Relations
  products         Product[]         @relation("SellerProducts")
  chats            ChatParticipant[]
  messages         Message[]
  wishlists        Wishlist[]
  reviewsGiven     Review[]          @relation("Reviewer")
  reviewsReceived  Review[]          @relation("Reviewee")
  reportsFiled     Report[]          @relation("Reporter")
  notifications    Notification[]
  savedSearches    SavedSearch[]
  searchHistories  SearchHistory[]
  recentlyViewed   RecentlyViewed[]
  activityLogs     ActivityLog[]
  deviceSessions   DeviceSession[]
  adminLogs        AdminLog[]
  ordersBought     Order[]           @relation("BuyerOrders")
  rentals          Rental[]          @relation("RenterRentals")
  exchanges        ExchangeRequest[] @relation("RequesterExchanges")

  @@index([email])
  @@index([collegeId])
}

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  icon        String?
  description String?
  products    Product[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Product {
  id              String           @id @default(cuid())
  title           String
  description     String
  price           Float
  rentalPrice     Float?
  condition       ProductCondition @default(GOOD)
  categorySlug    String
  category        Category         @relation(fields: [categorySlug], references: [slug])
  sellerId        String
  seller          User             @relation("SellerProducts", fields: [sellerId], references: [id])
  collegeId       String
  college         College          @relation(fields: [collegeId], references: [id])
  departmentId    String?
  department      Department?      @relation(fields: [departmentId], references: [id])
  
  pickupLocation  String
  pickupTime      String?
  isNegotiable    Boolean          @default(false)
  transactionType TransactionType  @default(SELL)
  status          ProductStatus    @default(ACTIVE)
  
  viewsCount      Int              @default(0)
  likesCount      Int              @default(0)
  tags            String[]
  
  images          ProductImage[]
  aiAnalysis      AIAnalysis?
  
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deletedAt       DateTime?

  // Relations
  wishlistedBy    Wishlist[]
  orders          OrderItem[]
  rentals         Rental[]
  exchanges       ExchangeRequest[]
  reports         Report[]
  recentlyViewed  RecentlyViewed[]
  chats           Chat[]

  @@index([collegeId])
  @@index([categorySlug])
  @@index([status])
  @@index([transactionType])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  publicId  String?  // Cloudinary Public ID
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
}

model AIAnalysis {
  id               String   @id @default(cuid())
  productId        String   @unique
  product          Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  recommendedPrice Float
  quickSalePrice   Float
  marketPrice      Float
  scamScore        Int      @default(0)
  aiSummary        String
  isFlagged        Boolean  @default(false)
  createdAt        DateTime @default(now())
}

model Wishlist {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model Order {
  id        String      @id @default(cuid())
  buyerId   String
  buyer     User        @relation("BuyerOrders", fields: [buyerId], references: [id])
  total     Float
  status    OrderStatus @default(PENDING)
  items     OrderItem[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  price     Float
  createdAt DateTime @default(now())
}

model Rental {
  id         String       @id @default(cuid())
  productId  String
  product    Product      @relation(fields: [productId], references: [id])
  renterId   String
  renter     User         @relation("RenterRentals", fields: [renterId], references: [id])
  startDate  DateTime
  endDate    DateTime
  dailyRate  Float
  totalCost  Float
  status     RentalStatus @default(REQUESTED)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
}

model ExchangeRequest {
  id          String         @id @default(cuid())
  productId   String
  product     Product        @relation(fields: [productId], references: [id])
  requesterId String
  requester   User           @relation("RequesterExchanges", fields: [requesterId], references: [id])
  offerNotes  String
  status      ExchangeStatus @default(PENDING)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model Chat {
  id           String            @id @default(cuid())
  productId    String?
  product      Product?          @relation(fields: [productId], references: [id])
  participants ChatParticipant[]
  messages     Message[]
  lastMessage  String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
}

model ChatParticipant {
  id        String   @id @default(cuid())
  chatId    String
  chat      Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt  DateTime @default(now())

  @@unique([chatId, userId])
}

model Message {
  id        String   @id @default(cuid())
  chatId    String
  chat      Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User     @relation(fields: [senderId], references: [id])
  text      String?
  image     String?
  file      String?
  seen      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Review {
  id         String   @id @default(cuid())
  reviewerId String
  reviewer   User     @relation("Reviewer", fields: [reviewerId], references: [id])
  revieweeId String
  reviewee   User     @relation("Reviewee", fields: [revieweeId], references: [id])
  rating     Int
  comment    String
  createdAt  DateTime @default(now())
}

model Report {
  id                String       @id @default(cuid())
  reporterId        String
  reporter          User         @relation("Reporter", fields: [reporterId], references: [id])
  reportedProductId String?
  reportedProduct   Product?     @relation(fields: [reportedProductId], references: [id])
  reason            String
  status            ReportStatus @default(PENDING)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
}

model Notification {
  id          String           @id @default(cuid())
  recipientId String
  recipient   User             @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  type        NotificationType
  title       String
  body        String
  referenceId String?
  isRead      Boolean          @default(false)
  createdAt   DateTime         @default(now())
}

model SavedSearch {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  query     String
  filters   Json?
  createdAt DateTime @default(now())
}

model SearchHistory {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  query     String
  createdAt DateTime @default(now())
}

model RecentlyViewed {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  viewedAt  DateTime @default(now())

  @@unique([userId, productId])
}

model CampusTrend {
  id          String   @id @default(cuid())
  collegeId   String
  category    String
  searchCount Int      @default(1)
  updatedAt   DateTime @updatedAt
}

model HeatmapEvent {
  id         String   @id @default(cuid())
  collegeId  String
  location   String
  activity   String
  createdAt  DateTime @default(now())
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String
  metadata  Json?
  createdAt DateTime @default(now())
}

model DeviceSession {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token        String   @unique
  refreshToken String   @unique
  deviceInfo   String?
  ipAddress    String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())
}

model FeatureFlag {
  id          String   @id @default(cuid())
  key         String   @unique
  enabled     Boolean  @default(false)
  description String?
  createdAt   DateTime @default(now())
}

model AdminLog {
  id        String   @id @default(cuid())
  adminId   String
  admin     User     @relation(fields: [adminId], references: [id])
  action    String
  target    String?
  details   Json?
  createdAt DateTime @default(now())
}
